# ==============================================================================
# Viksit Bengal Dashboard - Environment Configuration (.env.example)
# Copy this file to .env and replace placeholders with your actual environment values.
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/viksit_bengal?schema=public"

# Frontend Public API URL (NestJS Backend Endpoint)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Backend API Port
PORT=3001

# JWT Secret for Session Authentication & RBAC Guards
JWT_SECRET="YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"

# Optional AI Scraper & LLM Integration (Google Gemini / OpenAI / Anthropic)
AI_SCRAPER_ENABLED="true"
AI_SCRAPER_POLL_INTERVAL_HOURS="6"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Monitored State Sources (Comma-separated)
MONITORED_SOURCES="https://egazette.wb.gov.in,https://wbtenders.gov.in,https://pib.gov.in/kolkata,https://wbhealth.gov.in,https://wbfin.wb.gov.in"